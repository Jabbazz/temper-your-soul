{
  "name": "temper-your-soul",
  "version": "0.2.0",
  "private": true,
  "description": "Temper your soul: gioco d'azione 2D per browser, in TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "verify": "npm run typecheck && vitest run && vite build",
    "server": "tsx server/index.ts",
    "benchmark:network": "node --import tsx tools/network-benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "ws": "8.22.1"
  }
}
